# Local runtime stores and extracted working copies.
/data/
/datasets/extracted/
*.sqlite
*.sqlite3
*.db

# Auth module runtime store: holds password hashes and live sessions, so it is
# never committed. db/schema.sql and db/analytics_seed.sql stay tracked.
/db/auth.sqlite3
/db/auth.sqlite3-shm
/db/auth.sqlite3-wal
/db/private_key.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / frontend build output
node_modules/
frontend/dist/
npm-debug.log*

# Local data / runtime state (backend)
backend/data/aeza.db
backend/data/*.db
# Database backups produced by scripts/backup.sh. They contain real customer and
# account data and must never be committed.
/backups/
*.sql.dump
# RAG index is a rebuildable artifact: python -m backend.app.ai.rag --docs docs
backend/data/rag_index.json
/db/postgres/

# Secrets and local env
.env
.env.local
# Ad-hoc copies of env/compose files made before an edit. They carry the same
# secrets as .env and must never be committed; the pattern caught one such leak.
.env.*
*.env.bak
docker-compose.yml.bak*
docker-compose.yml.before*
# Stray "*.py.bak" copies of source files. One (backend/auth/passwords.py.bak)
# was committed upstream; the file is code, but it is still a backup artifact
# that must not live in the tree.
*.py.bak
!.env.example

# Tooling scratch
.tmp_local/
.playwright-mcp/
.agent_tmp/
*.log

# TypeScript incremental build info
frontend/tsconfig.tsbuildinfo

# Editors / OS
.DS_Store
.idea/
.vscode/

# Deck render output (PDF + rasterised slide previews)
/render/
/render_final/
/docs/deck/render/

# Local-only compose overrides (published sandbox ports).
docker-compose.override.yml

# Local SQLite authentication database and runtime files
/db/auth.sqlite3
/db/auth.sqlite3-wal
/db/auth.sqlite3-shm

# Состояние forge.sh/forge.bat: PID-файлы и логи запусков
.run/
