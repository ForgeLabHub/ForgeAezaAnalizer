# Copy to .env and adjust. Never commit real secrets.

# --- Authentication -----------------------------------------------------------
# Local development values. Replace the origins and enable secure cookies in production.
# Create accounts explicitly with `docker compose exec api python -m backend.users create <login>`.
# The SQLite database and generated RS256 key live in the persistent auth volume.
AUTH_ISSUER=http://localhost:8080
AUTH_FRONTEND_LOGIN_URL=http://localhost:8080/login
AUTH_COOKIE_SECURE=false

# --- Database -----------------------------------------------------------------
# Analytics live in PostgreSQL. Auth users live in a separate SQLite database.
AEZA_DATABASE_URL=postgresql+psycopg://aeza:aeza@localhost:5432/aeza

# --- Docker Compose -----------------------------------------------------------
# docker compose reads these. There are NO defaults in docker-compose.yml:
# the stack refuses to start until POSTGRES_PASSWORD, AEZA_JWT_SECRET,
# AEZA_ADMIN_EMAIL and AEZA_ADMIN_PASSWORD are set. This is deliberate, so a
# shared environment can never boot with the demo credentials below.
POSTGRES_DB=aeza
POSTGRES_USER=aeza
POSTGRES_PASSWORD=change-me-too
# Restrict to the SPA origin when the stack is reachable by anyone but you.
AEZA_CORS_ORIGINS=http://localhost:8080

# --- Data ---------------------------------------------------------------------
# Official organiser snapshot (10 accounts / 30 services / 100 transactions).
# Compose seeds this through the app's validated importer on first start.
AEZA_SNAPSHOT_PATH=dataset/data.json
AEZA_SEED_DEMO_DATA=0
# Reference instant for analytics. Defaults to the dataset's documented
# reference (2026-10-19T15:00:00Z), which keeps scores reproducible.
# Use ISO-8601 to move it, or "now" for a live wall-clock view.
AEZA_AS_OF=2026-10-19T15:00:00+00:00
# Analytics module factory: package.module:create. The bundled explainable
# risk engine is the default; leaving this empty makes every analytics route
# return 503 ("Расчёт ещё не опубликован").
AEZA_ANALYTICS_FACTORY=backend.app.domain.module:create
AEZA_RECALCULATE_SECONDS=60
# Optional dedicated Bearer token for Prometheus; otherwise an analyst session.
AEZA_METRICS_TOKEN=

# --- Local LLM (Ollama) --------------------------------------------------------
# Two independent AI surfaces exist in this repository and each has its own
# settings block. Both are off by default; neither is on the analytics path.
#
# 1) AI Analyst (backend/app/ai, routes under /api/v1/ai). See docs/AI_ANALYST.md.
# Master feature flag. When 0 the product works normally and AI routes return 503.
AEZA_AI_ENABLED=0
AEZA_AI_PROVIDER=ollama
AEZA_AI_MODEL=qwen2.5:3b-instruct
AEZA_AI_BASE_URL=http://127.0.0.1:11434
AEZA_AI_TIMEOUT_SECONDS=420
AEZA_AI_MAX_CONCURRENCY=1
AEZA_AI_NUM_CTX=4096
AEZA_AI_MAX_TOKENS=1200
AEZA_AI_TEMPERATURE=0.1
AEZA_AI_MAX_QUESTION_CHARS=2000
AEZA_AI_MAX_CONTEXT_CHARS=1600
AEZA_AI_RAG_TOP_K=2
AEZA_AI_MAX_RETRIES=1
AEZA_AI_RAG_INDEX_PATH=backend/data/rag_index.json
AEZA_AI_DOCS_PATH=docs

# 2) Aggregate assistant (POST /api/v1/insights/ai). See docs/AI_ASSISTANT.md.
# Master flag for this surface; when 0 the endpoint answers 503 and the
# deterministic analysis is unaffected.
AEZA_LLM_ENABLED=0
# AEZA_OLLAMA_URL is the canonical name; the older AEZA_LLM_BASE_URL still works
# as an alias. If Ollama runs on the host and the app runs in Compose, use the
# bridge gateway (172.18.0.1) or the host's LAN address — 127.0.0.1 would be the
# container itself.
AEZA_OLLAMA_URL=http://172.18.0.1:11434
AEZA_OLLAMA_MODEL=qwen2.5:7b
AEZA_OLLAMA_TIMEOUT_SECONDS=90
AEZA_LLM_MAX_TOKENS=700
AEZA_LLM_TEMPERATURE=0.2

# Older spellings of the three settings above. They still work and take effect
# only when the AEZA_OLLAMA_* name is absent, so an existing .env keeps running.
AEZA_LLM_BASE_URL=http://172.18.0.1:11434
AEZA_LLM_MODEL=qwen2.5:7b
AEZA_LLM_TIMEOUT_SECONDS=90

# --- Telegram integration -----------------------------------------------------
# Off by default. The app starts and works normally with these unset.
TELEGRAM_ENABLED=false
# Token from @BotFather. Set it on the server only — never commit a real token.
TELEGRAM_BOT_TOKEN=
# Shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL of this API plus /api/v1/telegram/webhook, e.g.
# https://aeza-sentinel.pixel-minds.ru/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
# Lifetime of a one-time account-linking code, and how many wrong attempts it allows.
TELEGRAM_LINK_CODE_TTL_SECONDS=600
TELEGRAM_LINK_MAX_ATTEMPTS=5
# Minimum seconds between two messages to the same chat.
TELEGRAM_MIN_SEND_INTERVAL_SECONDS=3
TELEGRAM_MAX_RETRIES=2
# Base URL used to build deep links back into the Sentinel UI.
TELEGRAM_APP_BASE_URL=http://localhost:8080
# Daily digest: how often the scheduler checks, and the UTC hour it sends at.
TELEGRAM_DIGEST_CHECK_SECONDS=300
TELEGRAM_DIGEST_HOUR_UTC=9
